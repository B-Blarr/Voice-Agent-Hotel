# Copy to api/.env for local development and fill in. Never commit the real .env.
# Generate SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# The local database from dev/compose.yaml listens here, all its passwords are "lokal".
DB_HOST=127.0.0.1
DB_PORT=15432

# Django's own database (users, sessions), as the role from sql/011_team_database.sql
TEAM_DB_NAME=team
TEAM_DB_USER=team_django
TEAM_DB_PASSWORD=

# The hotel database, as the role from sql/010_team_role.sql
HOTEL_DB_NAME=hotel
HOTEL_DB_USER=hotel_team
HOTEL_DB_PASSWORD=
