      ],
      "id": "ac32dd15-3723-48e5-ad93-1b5799974655",
      "name": "Webhook",
      "webhookId": "c511bc42-e180-442c-807c-e3e95e27247e"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst header = item.json.headers['elevenlabs-signature'] ?? '';\n\n// Header looks like: t=1793043221,v0=f56f4e04...\nconst teile = Object.fromEntries(\n  header.split(',').map((teil) => teil.split('='))\n);\n\n// The raw body exactly as ElevenLabs sent it\nconst roh = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n\nreturn [{\n  json: {\n    t: teile.t ?? null,\n    v0: teile.v0 ? 'v0=' + teile.v0 : null,\n    signiert: `${teile.t}.${roh}`,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "5d9e79fb-14db-49ef-a54c-3fe0045d788f",
      "name": "Prepare signature"
    },
    {
      "parameters": {
        "action": "hmac",
        "value": "={{ $json.signiert }}",
        "dataPropertyName": "berechnet"
      },
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "0b4729d1-eaf7-4e4f-9f80-37f8bd1218bd",
      "name": "Crypto",
      "credentials": {
        "crypto": {
          "id": "6yZ6XuVcIJsSy5Kx",
          "name": "ElevenLabs Webhook Secret"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{ \"ok\": true }",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1376,
        -144
      ],
      "id": "85c010ef-2ce0-4ff9-bd36-5eabc3919e25",
      "name": "Respond 200"
    },
    {
      "parameters": {
        "jsCode": "const pruefung = $input.first().json;\nconst body = $('Webhook').first().json.body;\n\n// 1. Is the signature right, and is the message fresh?\nconst echt = pruefung.v0 === 'v0=' + pruefung.berechnet;\nconst alter = Math.abs(Date.now() / 1000 - Number(pruefung.t));\nconst frisch = alter < 30 * 60;\n\nif (!echt || !frisch) {\n  return [{ json: { ok: false, grund: !echt ? 'signatur_falsch' : 'zu_alt' } }];\n}\n\n// 2. Take only the fields we store, everything else is dropped\nconst d = body.data ?? {};\nconst m = d.metadata ?? {};\nconst a = d.analysis ?? {};\n\nreturn [{\n  json: {\n    ok: true,\n    anruf_id: d.conversation_id,\n    beginn: new Date(m.start_time_unix_secs * 1000).toISOString(),\n    dauer_sek: m.call_duration_secs,\n    kosten_credits: m.cost ?? null,\n    kosten_usd: m.cost_fiat ?? null,\n    kanal: m.conversation_initiation_source ?? 'unbekannt',\n    beendet_durch: m.termination_reason ?? null,\n    erfolgreich: a.call_successful ?? null,\n    titel: a.call_summary_title ?? null,\n    stimmung: a.sentiment_analysis?.overall_label ?? null,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
