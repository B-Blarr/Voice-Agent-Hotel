    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? {};\nconst fehler = [];\n\n// A date must look like 2026-11-13 and really exist\nconst istDatum = (s) =>\n  typeof s === 'string' &&\n  /^\\d{4}-\\d{2}-\\d{2}$/.test(s) &&\n  new Date(s + 'T00:00:00Z').toISOString().slice(0, 10) === s;\n\n// Text fields: trimmed, or null when empty\nconst text = (v) => {\n  const t = String(v ?? '').trim();\n  return t === '' ? null : t;\n};\n\nconst heute = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Berlin' });\n\nconst kategorie = text(body.kategorie)?.toLowerCase() ?? null;\nconst anreise = body.anreise;\nconst abreise = body.abreise;\nconst erwachsene = Number(body.erwachsene);\nconst kinder = Number(body.kinder ?? 0);\nconst babys = Number(body.babys ?? 0);\nconst name = text(body.name);\nconst telefon = text(body.telefon);\nconst email = text(body.email);\n\nif (!['einzelzimmer', 'doppelzimmer', 'suite'].includes(kategorie)) fehler.push('kategorie');\nif (!istDatum(anreise)) fehler.push('anreise');\nif (!istDatum(abreise)) fehler.push('abreise');\nif (istDatum(anreise) && anreise < heute) fehler.push('anreise_in_vergangenheit');\nif (istDatum(anreise) && istDatum(abreise) && abreise <= anreise) fehler.push('abreise_nicht_nach_anreise');\nif (!Number.isInteger(erwachsene) || erwachsene < 1) fehler.push('erwachsene');\nif (!Number.isInteger(kinder) || kinder < 0) fehler.push('kinder');\nif (!Number.isInteger(babys) || babys < 0 || babys > 1) fehler.push('babys');\nif (!name) fehler.push('name');\nif (!telefon && !email) fehler.push('telefon_oder_email');\n\nreturn [{\n  json: {\n    ok: fehler.length === 0,\n    fehler,\n    kategorie,\n    anreise,\n    abreise,\n    erwachsene,\n    kinder,\n    babys,\n    betten_getrennt: body.betten_getrennt === true,\n    barrierefrei: body.barrierefrei === true,\n    wuensche: text(body.wuensche),\n    name,\n    telefon,\n    email,\n    quelle: 'telefon',\n    anruf_id: text(body.anruf_id),\n  },\n}];"
      },
