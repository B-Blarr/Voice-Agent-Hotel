    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? {};\nconst fehler = [];\n\n// A date must look like 2026-11-13 and really exist (no 31 February)\nconst istDatum = (s) =>\n  typeof s === 'string' &&\n  /^\\d{4}-\\d{2}-\\d{2}$/.test(s) &&\n  new Date(s + 'T00:00:00Z').toISOString().slice(0, 10) === s;\n\n// Today in German time, as 2026-10-21\nconst heute = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Berlin' });\n\nconst anreise = body.anreise;\nconst abreise = body.abreise;\nconst erwachsene = Number(body.erwachsene);\nconst kinder = Number(body.kinder ?? 0);\nconst babys = Number(body.babys ?? 0);\n\nif (!istDatum(anreise)) fehler.push('anreise');\nif (!istDatum(abreise)) fehler.push('abreise');\nif (istDatum(anreise) && anreise < heute) fehler.push('anreise_in_vergangenheit');\nif (istDatum(anreise) && istDatum(abreise) && abreise <= anreise) fehler.push('abreise_nicht_nach_anreise');\nif (!Number.isInteger(erwachsene) || erwachsene < 1) fehler.push('erwachsene');\nif (!Number.isInteger(kinder) || kinder < 0) fehler.push('kinder');\nif (!Number.isInteger(babys) || babys < 0) fehler.push('babys');\n\nreturn [{\n  json: {\n    ok: fehler.length === 0,\n    fehler,\n    anreise,\n    abreise,\n    erwachsene,\n    kinder,\n    babys,\n    betten_getrennt: body.betten_getrennt === true,\n    barrierefrei: body.barrierefrei === true,\n  },\n}];"
      },
